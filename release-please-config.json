{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    {
      "type": "cargo-workspace"
    },
    {
      "type": "linked-versions",
      "groupName": "topogen-workspace",
      "components": ["topogen", "topogen_derive"]
    }
  ],
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "topogen",
      "component": "topogen",
      "extra-files": ["flake.nix"]
    },
    "topogen_derive": {
      "release-type": "rust",
      "package-name": "topogen_derive",
      "component": "topogen_derive"
    }
  }
}
